Algoritmo NumeroSecreto
	Definir num Como Entero
	Definir Minum Como Entero
	
	num<- Azar(100+1)
	Escribir "Ingrese el numero que eligio :"
	Leer Minum
	
	Mientras Minum <> num Hacer
		si Minum < num Entonces
			Escribir "Su numero es menor al numero secreto."
		sino 
			Escribir "Su numero es mayor al numero secreto."
		FinSi
		Escribir "Ingrese un numero nuevamente"
		Leer Minum
	FinMientras
	Escribir "Su numero es correcto"
	
	
FinAlgoritmo

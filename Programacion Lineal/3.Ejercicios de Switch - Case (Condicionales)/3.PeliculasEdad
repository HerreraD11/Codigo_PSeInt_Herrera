Algoritmo PeliculasEdad
	Definir Edad Como Entero
	Definir categoria Como Entero
	//
	Escribir "Ingrese su edad, para saber su estilo de pelicula:"
	Leer Edad
	//
	si edad <0 o edad > 100 Entonces
		Escribir "Su edad no es valida, intentelo nuevamente"
	SiNo
		si edad < 7 Entonces
		categoria<- 1
	SiNo
		si edad <= 17 Entonces
			categoria<-2
		SiNo
			si edad <= 30
				categoria<-3
			SiNo
				categoria<-4
			FinSi
		FinSi
	FinSi
	Segun categoria Hacer
		1:
			Escribir "Peliculas recomendades de: Animadas y educativas."
		2:
			Escribir "Peliculas recomendades de: Animaciones, aventura y comedia familiar."
		3:
			Escribir "Peliculas recomendades de: Accion, drama comedia y cine ficcion."
		4:
			Escribir "Peliculas recomendades de: Clasicas y drama."
	FinSegun
FinSi

FinAlgoritmo

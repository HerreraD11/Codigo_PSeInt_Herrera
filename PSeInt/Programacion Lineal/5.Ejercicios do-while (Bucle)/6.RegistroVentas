Algoritmo RegistroVentas
	Definir registro Como Caracter
	Definir producto Como Caracter
	Definir precio Como Real
	Definir total Como Real
	Definir ventas Como Entero
	
	accion<- "S"
	registro<- ""
	total<- 0
	ventas<-0
	
	
	Repetir
		Escribir "Ingrese el nombre del producto de la compra"
		Leer producto
		Escribir "Ingrese el precio del producto de la compra"
		Leer precio
		si precio > 0 Entonces
			total<- total + precio
			ventas<- ventas + 1
			registro<- registro + " Productos: " + producto + ", Precios: " + ConvertirATexto(precio) + "/"
		SiNo
			Escribir "Ingrese un valor positivo."
		FinSi
		Escribir "Desea agregar otro producto: (S/N)"
		Leer accion
		
	Hasta Que accion = "N"
	
	Escribir "RESUMEN DE TUS VENTAS:"
	Escribir registro
	
	Escribir "Compraste : " ventas " objetos."
	Escribir "El valor total de su compra es de : " total
	
FinAlgoritmo

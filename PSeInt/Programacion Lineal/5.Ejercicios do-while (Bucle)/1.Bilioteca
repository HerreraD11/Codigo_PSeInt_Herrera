Algoritmo Bilioteca
	Definir titulo Como Caracter
	Definir autor Como Caracter
	Definir lista Como Caracter
	Definir respuesta Como Caracter
    Definir paginas Como Entero
	
    respuesta <- "S"
	
    Repetir
        Escribir "Ingrese el titulo del libro:"
        Leer titulo
		
        Escribir "Ingrese el autor:"
        Leer autor
		
        Escribir "Ingrese el numero de paginas:"
        Leer paginas
		
        lista <- lista + "Titulo: " + titulo + ", Autor: " + autor + ", Paginas: " + ConvertirATexto(paginas) + "\"
		
        Escribir "Desea registrar otro libro? S/N"
        Leer respuesta
    Hasta Que Mayusculas(respuesta) = "N"
	
    Escribir "Los libros registrados en la biblioteca son:"
    Escribir lista

FinAlgoritmo
